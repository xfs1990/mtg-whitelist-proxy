PORT=18188
ADD_PORT=8080
IMAGE=ghcr.io/xfs1990/mtg-whitelist-proxy:latest

# Generate one with:
# docker run --rm nineseconds/mtg:2 generate-secret cloudflare.com
SECRET=
DOMAIN=cloudflare.com
# Optional: force the host used in generated Telegram links.
PUBLIC_HOST=

# auto, prefer-ipv4, prefer-ipv6, only-ipv4, only-ipv6
IP_MODE=auto

# OFF, IP, SUBNET
WHITELIST_MODE=SUBNET
IPV4_SUBNET=32
IPV6_SUBNET=64

ADD_TOKEN=
LOG_LEVEL=info
