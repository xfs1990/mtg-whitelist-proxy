# Optional. If empty, generated once and stored under /data/generated/.
PORT=
ADD_PORT=
IMAGE=ghcr.io/xfs1990/mtg-whitelist-proxy:latest

# Optional. If empty, generated once from DOMAIN and stored under /data/generated/.
SECRET=
DOMAIN=cloudflare.com
# Optional. If empty, Cloudflare / Google DoH IPs are tested automatically.
MTG_DOH_IP=
# Optional: force the host used in generated Telegram links.
PUBLIC_HOST=
# Optional: override addresses shown in startup logs and the add page.
PUBLIC_IPV4=
PUBLIC_IPV6=

# auto, prefer-ipv4, prefer-ipv6, only-ipv4, only-ipv6
IP_MODE=auto

# OFF, IP, SUBNET
WHITELIST_MODE=SUBNET
IPV4_SUBNET=32
IPV6_SUBNET=64

# Optional. If empty, generated once and stored under /data/generated/.
ADD_TOKEN=
LOG_LEVEL=info
